# CatalogVector environment variables.
# Copy to .env.local and fill in. Never commit .env.local (gitignored).
# Phase 1 infra is not yet provisioned — keys are optional until wired.

# --- Node / Next ---
NODE_ENV=development

# --- I-5: Postgres + pgvector (TDD §4) ---
# Required once src/db is wired. postgres:// or postgresql:// with pgvector ext.
DATABASE_URL=

# --- I-6: Redis (C7 distributed rate limiter, TDD §5 C7) ---
# Required once C7 is wired. redis:// or rediss://
REDIS_URL=

# --- I-7: Inngest self-hosted (C8 orchestration, TDD §5 C8) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- I-4: UCP agent profile (TDD §2.4) — LEAD-TIME RISK, DO FIRST ---
# Well-known URL hosting the UCP agent profile. Required for C3 (Global Catalog).
UCP_AGENT_PROFILE_URL=

# --- LLM routing (TDD §7: OpenRouter, cost as first-class constraint) ---
OPENROUTER_API_KEY=

# --- Embedding model (TDD §4: 1536-dim vectors) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
