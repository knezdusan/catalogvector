# CatalogVector environment variables.
# Copy to .env.local and fill in. Never commit .env.local (gitignored).
# Phase 1 infra is not yet provisioned — keys are optional until wired.

# --- Node / Next ---
NODE_ENV=development

# --- I-5: Postgres + pgvector (TDD §4) ---
# Required once src/db is wired. postgres:// or postgresql:// with pgvector ext.
DATABASE_URL=

# --- I-6: Redis (C7 distributed rate limiter, TDD §5 C7) ---
# Required once C7 is wired. redis:// or rediss://
REDIS_URL=

# --- I-7: Inngest self-hosted (C8 orchestration, TDD §5 C8) ---
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- I-4: UCP agent profile + API key (TDD §2.4, updated 31 Jul 2026) ---
# Profile URL: public HTTPS URL hosting the UCP agent profile JSON.
#   Hosted in this repo at public/ucp-agent-profile.json.
#   GitHub raw URL: https://raw.githubusercontent.com/knezdusan/catalogvector/main/public/ucp-agent-profile.json
#   (Switch to your own domain once the app is deployed.)
UCP_AGENT_PROFILE_URL=https://raw.githubusercontent.com/knezdusan/catalogvector/main/public/ucp-agent-profile.json

# API key: from Dev Dashboard → Catalogs → Get an API key (instant, no approval).
# Token tier = highest rate limits. Scope: read_global_api_catalog_search.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# --- LLM routing (TDD §7: OpenRouter, cost as first-class constraint) ---
OPENROUTER_API_KEY=

# --- Embedding model (TDD §4: 1536-dim vectors) ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
